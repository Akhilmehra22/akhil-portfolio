# Copy this file to .env for local testing with `netlify dev`.
# Never commit the real .env — it's already in .gitignore.

# Required. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional. Defaults to gpt-4o-mini (cheap, fast, good enough for this).
OPENAI_MODEL=gpt-4o-mini
